# Browser: the fork the app reads and sends to (the wallet only signs).
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
# Server routes (cheatcodes, keeper steps). Never put MAINNET_RPC or a key in a NEXT_PUBLIC_* variable.
RPC_URL=http://127.0.0.1:8899
# Optional: WalletConnect (connect any mobile wallet by QR code). A free project id from https://cloud.reown.com; without
# one, WalletConnect is simply not offered. Every wallet-standard wallet (Phantom, Solflare, Backpack, …) works without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
