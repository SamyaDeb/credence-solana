{
  "name": "@credence/widget",
  "version": "0.1.0",
  "description": "Credence (Solana) embeddable React widget: the weekend gap line, risk, a quote and a buy button next to a lending position. Never holds keys, never signs; fork only until the program is deployed.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --dir ../sdk build && tsup && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run"
  },
  "peerDependencies": {
    "@anchor-lang/core": "1.2.1",
    "@credence/sdk": "0.1.0",
    "@solana/web3.js": "1.99.0",
    "bn.js": "^5.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.2.1",
    "@credence/sdk": "link:../sdk",
    "@solana/web3.js": "1.99.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bn.js": "^5.2.5",
    "jsdom": "^27.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  }
}
